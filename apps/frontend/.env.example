NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
# Configuration ID del Embedded Signup (WhatsApp > Configuration en Meta for Developers)
# Si no lo tienes, deja vacío y se usará el App ID como fallback
NEXT_PUBLIC_META_CONFIG_ID=your_embedded_signup_config_id

# ─── Marca (ver src/lib/brand.ts) ───────────────────────────────────────────────
# Todas opcionales. Sin definirlas, el deploy se ve exactamente como "NetService Connect"
# (comportamiento de siempre) — solo hace falta setearlas en un deploy con otra identidad.
# NEXT_PUBLIC_BRAND_NAME="Tu Producto"
# NEXT_PUBLIC_BRAND_TAGLINE="Tu propia bajada de producto"
# Panel de acciones rápidas (crear ticket/tarea/cliente) que simula integrar con el
# sistema interno "NetService Core" — no tiene sentido fuera de esa marca.
# NEXT_PUBLIC_ENABLE_NETSERVICE_PANEL=false
