generator client {
  provider      = "prisma-client-js"
  // "native" = el binario del entorno donde corre `prisma generate` (Windows en el
  // deploy pm2 de siempre). "linux-musl-openssl-3.0.x" = motor para Alpine con
  // OpenSSL 3 (imagen node:20-alpine del deploy Docker) — sin esto, Prisma detecta
  // mal la versión de OpenSSL en musl y el backend crashea al arrancar buscando
  // libssl.so.1.1, que no existe en Alpine moderno.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  plan          String        @default("starter")
  isActive      Boolean       @default(true)
  openaiApiKey  String?
  openaiModel   String?
  /// Quien paga la IA de esta empresa. PLATFORM = usa nuestra clave y consume
  /// creditos, que es como se venden todas; BYOK = trae su propia clave y le factura el
  /// proveedor directamente.
  ///
  /// El default arranco en BYOK para que el despliegue del motor no le cambiara nada a
  /// nadie, y paso a PLATFORM cuando se decidio que todas las empresas se manejan por
  /// creditos. Las que ya existian siguen en BYOK hasta que se las pase a mano: cambiar
  /// un default no toca las filas que ya estan.
  aiBillingMode AiBillingMode @default(PLATFORM)
  // Quien vendio esta cuenta. Null = venta directa, que es como estan todas las que ya
  // existian. Se puede corregir despues: el primer tiempo la atribucion se carga a mano
  // mirando papeles, y equivocarse una vez no puede ser irreversible.
  partnerId     String?
  // Cuando se cerro la venta. Puede no coincidir con createdAt: el partner vende y
  // avisa, y el alta la hacemos nosotros despues.
  soldAt        DateTime?
  // Lo acordado para ESTA venta en particular, cuando difiere del trato general del
  // partner (que vive en Partner.agreement). Texto libre a proposito: el sistema no
  // calcula comisiones — no hay precios modelados — y un campo numerico daria a
  // entender que si.
  partnerNote   String?
  /// Zona horaria IANA de la empresa. La necesita la agenda: "las 9:00 del lunes" de un
  /// turno o una cita es hora local de la clinica, y el servidor corre en UTC. El default
  /// es Panama porque ahi estaban todas las empresas cuando se agrego el campo.
  timezone      String        @default("America/Panama")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users            User[]
  channelAccounts  ChannelAccount[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  tags             Tag[]
  auditLogs        AuditLog[]
  internalNotes    InternalNote[]
  quickReplies     QuickReply[]
  messageTemplates MessageTemplate[]
  campaigns        Campaign[]
  botConfig        TenantBotConfig?
  branches         TenantBranch[]
  menuNodes        TenantMenuNode[]
  bots             Bot[]
  contactTags      ContactTag[]
  supportRequests  SupportRequest[]
  aiUsages         AiUsage[]
  aiWallet         AiWallet?
  aiCreditLots     AiCreditLot[]
  aiCreditEntries  AiCreditEntry[]
  aiHolds          AiHold[]
  agendaSettings   AgendaSettings?
  doctors          Doctor[]
  doctorShifts     DoctorShift[]
  doctorExceptions DoctorException[]
  appointments     Appointment[]
  doctorSummaries  DoctorDailySummary[]
  partner          Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([partnerId])
}

// ─── Partner ──────────────────────────────────────────────────────────────────

/// Quien vende el sistema y nos trae clientes.
///
/// NO es un Tenant ni un User: es gente de la operacion comercial de quien opera este
/// servidor, no de ninguna empresa cliente. Por eso no tiene tenantId y solo lo ve el
/// super admin, igual que SystemConfig.
///
/// Tampoco entra al sistema: hoy no tiene acceso ni pantalla propia. Se modela aparte
/// de User justamente para que el dia que se le quiera dar acceso alcance con
/// asociarle un usuario, sin rehacer la atribucion que ya este cargada.
model Partner {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  /// Cedula o RUC. En Panama es lo que hace falta para poder pagarle.
  taxId     String?
  /// El trato general: "20% los primeros 12 meses". Texto libre y no un porcentaje
  /// numerico porque el sistema no liquida nada — no hay precios modelados — y un
  /// numero prometeria un calculo que no existe.
  agreement String?
  notes     String?
  /// Un partner que dejo de vender se desactiva, no se borra: sus ventas siguen siendo
  /// suyas y el historico tiene que poder explicarse.
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Las empresas que trajo. Si se borra el partner quedan sin partner (SetNull), no
  /// se borran con el.
  tenants Tenant[]
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  password     String
  name         String
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)
  // Operador de la plataforma (no es "admin de una empresa") — puede ver/editar
  // config global (System) y crear empresas nuevas. No tiene relacion con `role`.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConvs   Conversation[]       @relation("AssignedAgent")
  campaigns       Campaign[]
  channelAccess   UserChannelAccount[]
  resetTokens     PasswordResetToken[]
  messages        Message[]
  internalNotes   InternalNote[]
  auditLogs       AuditLog[]
  supportRequests SupportRequest[]
  aiUsages        AiUsage[]
  appointments    Appointment[]

  // Unico en todo el sistema, no por empresa: con el email repetido entre empresas el
  // login no puede saber a cual entrar (se quedaba con el primero que encontraba) y
  // "olvide mi contrasena" tampoco sabria a que cuenta apunta. Una persona que trabaje
  // para dos clientes necesita dos direcciones.
  @@unique([email])
  @@index([tenantId])
}

// Token de un solo uso para recuperar la contrasena.
//
// Se guarda el HASH del token, no el token: si alguien se lleva una copia de la base no
// puede usarla para entrar a ninguna cuenta. El valor en claro existe solo dentro del
// mail que recibe la persona.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  // Cuando se uso. Null = todavia sirve. No se borra la fila al usarla para poder
  // distinguir "este link ya se uso" de "este link nunca existio".
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  ADMIN
  SUPERVISOR
  AGENT
}

// ─── Channel Account ──────────────────────────────────────────────────────────

// Una cuenta por la que entran y salen mensajes: una linea de WhatsApp, una pagina de
// Facebook o una cuenta de Instagram. Un tenant puede tener varias (ej: una linea por
// sucursal). El webhook rutea por phoneNumberId / pageId / igAccountId segun el canal,
// asi que lo que separa una cuenta de otra es esta fila; la conversacion guarda por
// cual entro (Conversation.channelAccountId) y todo lo que sale — bot incluido — se
// manda por esa misma cuenta.
//
// Antes se llamaba WhatsAppAccount. Los campos propios de cada canal son nullable
// porque ninguno aplica a los tres; cual esta poblado lo dice `channel`, no hay que
// adivinarlo.
model ChannelAccount {
  id                 String               @id @default(cuid())
  tenantId           String
  channel            Channel              @default(WHATSAPP)
  // ─── WhatsApp (Cloud API) ───
  wabaId             String?
  phoneNumberId      String?
  // ─── Messenger / Instagram (Graph API) ───
  // pageId es la pagina de Facebook; para Instagram es ademas la pagina a la que la
  // cuenta de IG esta vinculada, porque los mensajes de IG entran por ahi.
  pageId             String?
  igAccountId        String?
  accessToken        String
  phoneNumber        String?
  displayName        String?
  businessName       String?
  businessId         String?
  // Nombre operativo de la linea, editable por el admin (ej: "Sucursal Palermo").
  // phoneNumber/displayName los define Meta y no se pueden cambiar desde aca.
  label              String?
  // Linea que se usa cuando no hay una conversacion de la cual deducirla: alta de
  // plantillas (se crean contra el WABA) y conversaciones salientes sin linea elegida.
  isDefault          Boolean              @default(false)
  sortOrder          Int                  @default(0)
  // Estado del numero segun Meta (CONNECTED / PENDING / FLAGGED / RESTRICTED / ...).
  // NO confundir con signupStatus, que describe nuestro flujo de alta: un numero puede
  // estar guardado y con webhook suscrito (signupStatus CONNECTED) pero todavia sin
  // registrar en la Cloud API, y en ese estado no puede enviar. Se cachea para poder
  // pintar la lista sin pegarle a Meta 15 veces; statusCheckedAt dice que tan viejo es.
  platformStatus     String?
  statusCheckedAt    DateTime?
  // Que bot atiende las conversaciones nuevas de esta linea. botId null = el bot por
  // defecto del tenant (asi una linea recien conectada ya tiene bot sin configurar
  // nada); botEnabled false = sin bot, la conversacion entra directo a los agentes.
  // Son dos campos y no un solo botId porque "usar el predeterminado" y "ninguno"
  // son cosas distintas y las dos necesitan poder expresarse.
  botId              String?
  botEnabled         Boolean              @default(true)
  webhookVerifyToken String               @default(cuid())
  isActive           Boolean              @default(true)
  signupStatus       EmbeddedSignupStatus @default(PENDING)
  tokenExpiresAt     DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bot              Bot?                 @relation(fields: [botId], references: [id], onDelete: SetNull)
  conversations    Conversation[]
  campaigns        Campaign[]
  userAccess       UserChannelAccount[]
  doctorShifts     DoctorShift[]
  doctorExceptions DoctorException[]
  appointments     Appointment[]

  // Los dos unique conviven porque en Postgres los NULL no colisionan entre si: una
  // cuenta de Instagram tiene phoneNumberId NULL y no pelea con las lineas de WhatsApp,
  // y al reves con pageId.
  @@unique([tenantId, phoneNumberId])
  @@unique([tenantId, pageId])
  // El webhook resuelve la cuenta en cada mensaje entrante: por phoneNumberId en
  // WhatsApp, por pageId en Messenger y por igAccountId en Instagram.
  @@index([tenantId])
  @@index([phoneNumberId])
  @@index([pageId])
  @@index([igAccountId])
}

enum Channel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

// Que lineas puede ver cada usuario. La ausencia de filas es lo que da el permiso:
// un usuario SIN ninguna fila ve TODAS las lineas del tenant. Es deliberado — asi
// limitar a alguien es una accion explicita y nadie pierde acceso por omision, que es
// lo que pasaria si el default fuera "no ve nada".
//
// Es independiente del rol: el rol decide QUE conversaciones ve (todas las del tenant
// o solo las asignadas a el) y esto decide DE QUE LINEAS. Se combinan, asi que un
// agente puede ver solo sus conversaciones asignadas y solo las de una sucursal.
model UserChannelAccount {
  userId           String
  channelAccountId String
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@id([userId, channelAccountId])
  @@index([userId])
  @@index([channelAccountId])
}

enum EmbeddedSignupStatus {
  PENDING
  CONNECTED
  FAILED
  DISCONNECTED
}

// ─── Contact ──────────────────────────────────────────────────────────────────

model Contact {
  id             String    @id @default(cuid())
  tenantId       String
  // Dejo de ser la identidad del contacto y paso a ser un dato mas de la ficha: quien
  // es en cada canal vive en ContactIdentity. Nullable porque un contacto que llego
  // por Instagram o Messenger no tiene telefono y nunca lo vamos a conocer.
  phone          String?
  name           String?
  email          String?
  company        String?
  avatarUrl      String?
  metadata       Json?
  // Cuando la persona pidio no recibir mas envios masivos. Se guarda la fecha y no un
  // booleano para poder decir desde cuando y por que canal llego la baja.
  // Una baja NO impide responderle si escribe: corta los envios proactivos, nada mas.
  optedOutAt     DateTime?
  optedOutReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  identities    ContactIdentity[]
  campaignItems CampaignRecipient[]
  tags          ContactTagLink[]
  appointments  Appointment[]

  // Se queda tal cual aunque phone sea nullable: en Postgres varios NULL no colisionan,
  // asi que esto sigue impidiendo dos contactos de WhatsApp con el mismo numero y no
  // molesta a los de Instagram y Messenger, que tienen phone NULL.
  @@unique([tenantId, phone])
  @@index([tenantId])
}

// Quien es un contacto en cada canal. Un Contact puede tener varias: es lo que permite
// que el cliente que escribe por WhatsApp y por Instagram sea una sola ficha para el
// agente, en vez de dos personas distintas.
model ContactIdentity {
  id         String   @id @default(cuid())
  tenantId   String
  contactId  String
  channel    Channel
  // El identificador de esa persona en ese canal: telefono E.164 en WhatsApp, PSID en
  // Messenger, IGSID en Instagram. Los dos ultimos son scoped por pagina — la misma
  // persona tiene otro id en otra pagina tuya — asi que no sirven fuera de su canal.
  externalId String
  // Handle publico, cuando el canal lo da: @usuario en Instagram. Messenger no tiene,
  // y en WhatsApp el telefono ya cumple ese rol.
  handle     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, externalId])
  @@index([contactId])
}

// ─── Conversation ─────────────────────────────────────────────────────────────

model Conversation {
  id               String                @id @default(cuid())
  tenantId         String
  contactId        String
  // Cuenta por la que entro (o por la que salio, si la inicio un agente): una linea de
  // WhatsApp, una pagina de Facebook o una cuenta de Instagram. Nullable por las
  // conversaciones anteriores al multi-numero y para no perder el historial si se borra
  // la cuenta. Todo envio la resuelve desde aca, y de aca sale tambien el canal.
  channelAccountId String?
  assignedUserId   String?
  status           ConversationStatus    @default(OPEN)
  // Modo del bot de menu (Fase D). Default AGENT a proposito: las conversaciones
  // que ya existian antes de esta migracion viven con un humano asignado y el
  // bot no debe tocarlas; solo el webhook crea conversaciones nuevas en modo BOT.
  mode             ConversationMode      @default(AGENT)
  botState         ConversationBotState?
  // Contexto liviano del bot que necesita sobrevivir entre turnos (ej: coincidencias
  // pendientes de una busqueda de sucursal). No confundir con AuditLog, que es historico.
  botContext       Json?
  // Bot con el que arranco la conversacion. Se fija al crearla y no cambia si despues
  // le asignan otro bot a la linea: la conversacion en curso termina con el arbol en
  // el que estaba navegando. Tambien es lo que separa las metricas por bot.
  botId            String?
  closedReason     String?
  lastMessageAt    DateTime?
  lastMessageText  String?
  lastInboundAt    DateTime?
  unreadCount      Int                   @default(0)
  // Traspaso: cuando la conversacion paso a manos de esta persona, y cuando ella la
  // abrio despues de ese traspaso. Mientras assignedSeenAt sea null o anterior a
  // assignedAt, la bandeja la marca como recien transferida. Son dos campos y no un
  // booleano para que un segundo traspaso vuelva a marcarla aunque el primero ya se
  // hubiera visto. No se mezcla con unreadCount, que cuenta mensajes sin leer del
  // cliente: una conversacion puede estar al dia y aun asi ser nueva para quien la recibe.
  assignedAt       DateTime?
  assignedSeenAt   DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact           @relation(fields: [contactId], references: [id])
  channelAccount ChannelAccount?   @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  bot            Bot?              @relation(fields: [botId], references: [id], onDelete: SetNull)
  assignedUser   User?             @relation("AssignedAgent", fields: [assignedUserId], references: [id])
  messages       Message[]
  notes          InternalNote[]
  tags           ConversationTag[]
  auditLogs      AuditLog[]
  aiUsages       AiUsage[]

  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, channelAccountId])
  @@index([botId])
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum ConversationMode {
  BOT
  AGENT
}

enum ConversationBotState {
  MENU
  AWAITING_ORDER_NUMBER
  // Legacy (Fase D, generalizadas por el arbol de menu configurable): ya no las
  // dispara el codigo nuevo, pero Postgres no permite dropear valores de enum sin
  // recrear el tipo, asi que quedan inertes como red de compatibilidad con
  // conversaciones que hayan quedado a mitad de camino al momento del deploy.
  BRANCH_MENU
  AWAITING_BRANCH_QUERY
  AWAITING_BRANCH_FOLLOWUP
  AWAITING_RESOLUTION_CONFIRMATION
  // Generalizan BRANCH_MENU/AWAITING_BRANCH_QUERY/AWAITING_BRANCH_FOLLOWUP/AWAITING_RESOLUTION_CONFIRMATION.
  AWAITING_QUERY
  AWAITING_POST_REPLY
  // Chat libre con OpenAI (nodo tipo AI_CHAT) hasta que el cliente sale por palabra clave.
  AWAITING_AI_CHAT
}

// ─── Message ──────────────────────────────────────────────────────────────────

model Message {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  senderId       String?
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  body           String?
  mediaUrl       String?
  mediaType      String?
  mediaMimeType  String?
  status         MessageStatus    @default(SENT)
  // Por que fallo la entrega, segun el webhook de estado de Meta (ej: "131049:
  // This message was not delivered to maintain healthy ecosystem engagement").
  // Meta acepta el mensaje y recien despues avisa que no lo entrego, asi que sin
  // esto un mensaje fallido era un icono rojo sin explicacion posible.
  failureReason  String?
  externalId     String?
  rawPayload     Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User?        @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@index([externalId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  VIDEO
  STICKER
  TEMPLATE
  // Una ubicacion: la que comparte un cliente o la que manda el bot desde un nodo
  // LOCATION. Las coordenadas viajan en rawPayload.location.
  LOCATION
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Internal Note ────────────────────────────────────────────────────────────

model InternalNote {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  userId         String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([conversationId])
}

// ─── Tag ──────────────────────────────────────────────────────────────────────
//
// El modulo de etiquetas se retiro del producto (2026-09-17): nadie lo entendia y
// confundia mas de lo que ayudaba. Las dos tablas quedan a proposito, con los datos
// que los tenants ya habian cargado, por si algun dia se reintroduce. Ningun codigo
// las consulta — si al final se decide que no vuelve, se borran con una migracion.

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations ConversationTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

// ─── Contact Tag ──────────────────────────────────────────────────────────────
//
// Etiquetas de CONTACTO ("mayorista", "moroso", "cliente VIP"): con que se segmenta
// una campaña. No confundir con Tag/ConversationTag, que son las etiquetas de
// conversacion retiradas del producto: aquellas describian un chat puntual, estas
// describen a la persona y sobreviven a la conversacion.

model ContactTag {
  id       String @id @default(cuid())
  tenantId String
  name     String
  // El nombre normalizado (minusculas, sin tildes, sin espacios de sobra). Es lo que
  // lleva el unique, no `name`: sin esto un tenant termina con "VIP", "vip" y "Vip"
  // como tres etiquetas distintas y ningun filtro sirve. `name` guarda como lo
  // escribieron, que es lo que se muestra.
  slug     String
  color    String @default("#6366f1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactTagLink[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// Que contacto lleva que etiqueta. Tabla aparte y no un array en Contact para poder
// renombrar una etiqueta en un solo lugar y filtrar por ella con un indice.
model ContactTagLink {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     ContactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  // Por aca busca el filtro de campañas: todos los contactos de una etiqueta.
  @@index([tagId])
}

// ─── Quick Reply ──────────────────────────────────────────────────────────────

model QuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  shortcut  String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@index([tenantId])
}

// ─── Message Template (plantillas de WhatsApp, aprobadas por Meta) ────────────

model MessageTemplate {
  id       String  @id @default(cuid())
  tenantId String
  // WABA donde vive la plantilla. Meta las guarda por WABA, no por numero: una
  // plantilla creada en un WABA no existe para un numero de otro, y enviarla da
  // el error 132001 ("template name does not exist in the translation"). Un tenant
  // con lineas en varios WABA necesita la misma plantilla en cada uno.
  wabaId   String?
  name     String
  language String  @default("es")
  category String // MARKETING | UTILITY | AUTHENTICATION

  // ── Componentes de la plantilla ────────────────────────────────────────────
  // Meta arma la plantilla con hasta 4 componentes: HEADER, BODY, FOOTER y
  // BUTTONS. Solo BODY es obligatorio; el resto se guarda aca para poder
  // reconstruir el envio y mostrar la vista previa sin volver a preguntarle a Meta.

  // TEXT | IMAGE — null es una plantilla sin encabezado.
  headerFormat    String?
  // Solo para headerFormat TEXT. Admite una unica variable y tiene que ser {{1}}.
  headerText      String?
  // Solo para headerFormat IMAGE: ruta relativa de nuestra copia, el mismo formato
  // que Message.mediaUrl. Se guarda para la vista previa y para poder re-subir la
  // imagen a Meta cuando el media id vence.
  headerMediaPath String?
  headerMediaMime String?
  // Cache de media ids de Meta por linea: { "<phoneNumberId>": { id, uploadedAt } }.
  // El id que devuelve /media vive ~30 dias y es por numero, no por WABA, asi que
  // no alcanza con guardar uno solo. Sin este cache, cada envio resubiria la imagen.
  headerMediaIds  Json?
  footerText      String?
  // [{ type: QUICK_REPLY|URL|PHONE_NUMBER, text, url?, urlExample?, phoneNumber? }]
  // El orden importa: es el index que Meta usa para los parametros de boton al enviar.
  buttons         Json?

  bodyText       String
  variableCount  Int      @default(0)
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  metaTemplateId String?
  rejectReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  // El nombre solo es unico dentro de su WABA — el mismo nombre puede (y suele
  // necesitar) existir en cada WABA del tenant.
  @@unique([tenantId, wabaId, name, language])
  @@index([tenantId])
}

// ─── Bot ──────────────────────────────────────────────────────────────────────
// Un tenant puede tener varios bots (ej: uno de ventas y otro de soporte) y cada
// linea de WhatsApp elige cual la atiende (ChannelAccount.botId). Un bot es su arbol
// de menu + la info de negocio que usa el modo IA + como arranca. La clave de OpenAI
// sigue siendo del tenant (Tenant.openaiApiKey), no se repite por bot.
//
// isDefault: el que atiende las lineas sin bot elegido. Hay uno por tenant; lo
// garantiza BotsService (se crea solo si falta), no un indice.

model Bot {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  // Info de negocio (horarios, servicios, politicas, FAQs) que alimenta el prompt
  // de los nodos AI_CHAT de este bot.
  aiKnowledgeBase String?
  // Si es true, una conversacion nueva arranca directo en modo IA en vez de
  // mostrar el arbol de menu. El menu sigue siendo alcanzable si el cliente
  // escribe "menu"/"volver" en medio del chat.
  startInAiChat   Boolean  @default(false)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuNodes       TenantMenuNode[]
  channelAccounts ChannelAccount[]
  conversations   Conversation[]

  @@index([tenantId])
}

// ─── Tenant Bot Config (Fase D: textos del menu de WhatsApp por empresa) ──────
// Sin uso desde que existe Bot: sus datos se copiaron al bot por defecto de cada
// tenant en la migracion 20260923000000_bots. Queda como red de rollback.

model TenantBotConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  horariosText    String?
  sucursalesText  String?
  serviciosText   String?
  // Info de negocio (horarios, servicios, politicas, FAQs) que alimenta el prompt
  // de cualquier nodo tipo AI_CHAT del arbol de menu. Tenant-wide, no por nodo.
  aiKnowledgeBase String?
  // Si es true, una conversacion nueva arranca directo en modo IA en vez de
  // mostrar el arbol de menu. El menu sigue siendo alcanzable si el cliente
  // escribe "menu"/"volver" en medio del chat.
  startInAiChat   Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Tenant Branch (sucursales administrables para el submenu del bot) ────────

model TenantBranch {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  address      String
  scheduleText String?
  phone        String?
  mapsUrl      String?
  servicesText String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Tenant Menu Node (menu de WhatsApp configurable, arbol generico) ─────────
// Reemplaza el menu hardcoded (MENU_OPTIONS) + TenantBranch: cada tenant arma su
// propio arbol de opciones. "Sucursales" ya no es un caso especial: es un nodo
// MENU con hijos TEXT, igual que cualquier otro submenu que arme un tenant.

model TenantMenuNode {
  id         String       @id @default(cuid())
  tenantId   String
  botId      String
  parentId   String?
  type       MenuNodeType @default(TEXT)
  title      String
  subtitle   String?
  bodyText   String?
  promptText String?
  config     Json?
  active     Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bot      Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  parent   TenantMenuNode?  @relation("MenuNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children TenantMenuNode[] @relation("MenuNodeChildren")

  @@index([tenantId, parentId])
  @@index([botId, parentId])
}

enum MenuNodeType {
  MENU
  TEXT
  ORDER_LOOKUP
  AGENT
  AI_CHAT
  // Manda una tarjeta de ubicacion de WhatsApp. Coordenadas en config (ver
  // common/maps-link.ts), sacadas del link de Google Maps que pega el admin.
  LOCATION
}

// ─── System Config (global, singleton) ───────────────────────────────────────

model SystemConfig {
  id                String   @id @default("1")
  metaAppId         String?
  metaConfigId      String?
  metaAppSecret     String?
  metaVerifyToken   String?
  metaApiVersion    String   @default("v19.0")
  mediaStoragePath  String?
  updatedAt         DateTime @updatedAt
  // ─── Correo saliente ───
  // Lo de aca tiene prioridad sobre las variables MAIL_* del entorno, igual que pasa
  // con las credenciales de Meta: quien tiene acceso al servidor usa el .env, quien no,
  // el panel. mailPass va CIFRADO (ver CryptoService) — es lo unico que permite mandar
  // correo firmado con el dominio del sistema.
  mailHost          String?
  mailPort          Int?
  mailUser          String?
  mailPass          String?
  mailFrom          String?
  // ─── Soporte ───
  // A donde llegan los reportes del boton de soporte. Es por entorno y no por empresa
  // a proposito: quien atiende el reporte es quien opera ESTE servidor, no el tenant.
  supportEmail      String?
  // ─── Creditos de IA ───
  // Parametros comerciales del motor de creditos. Viven en la base y no en el codigo
  // porque son precio, no logica: se ajustan sin redeploy y quedan igual en los dos
  // entornos. Un crédito vale aiCreditUsdValue dolares de venta; el markup es lo que
  // se le aplica al costo real del proveedor antes de convertirlo a creditos.
  aiMarkupFactor    Decimal  @default(2) @db.Decimal(6, 3)
  aiCreditUsdValue  Decimal  @default(0.001) @db.Decimal(12, 6)
  // Piso por operacion: sin esto, las llamadas mas baratas redondean a cero creditos
  // y se regalan.
  aiMinCreditsPerOp Int      @default(1)
  /// La clave de OpenAI con la que se atiende a los tenants en modo PLATFORM. Va
  /// CIFRADA (CryptoService), igual que mailPass y por la misma razon: en claro, una
  /// copia de la base alcanza para gastar con nuestra cuenta. La clave de un tenant en
  /// modo BYOK sigue siendo suya y no pasa por aca.
  aiPlatformApiKey  String?
  /// El modelo que se usa en modo PLATFORM. Lo decide la plataforma y no el cliente:
  /// con nuestra clave, esa eleccion regula nuestro costo. Medido contra un bot real,
  /// el modelo economico acerto 22 de 24 contra 23 del caro, costando 17 veces menos.
  aiPlatformModel   String   @default("gpt-4o-mini")
  /// Creditos de regalo con los que nace una empresa nueva. 0 = ninguno, y entonces su
  /// IA queda apagada hasta que alguien le acredite el primer paquete. Existe para que
  /// una cuenta nueva pueda probar el asistente el mismo dia del alta, sin que nadie
  /// tenga que acordarse de cargarle saldo.
  aiTrialCredits    Int      @default(0)
}

// ─── Soporte ──────────────────────────────────────────────────────────────────

/// Un reporte del boton "Soporte".
///
/// Se guarda ANTES de mandar el correo, y se guarda aunque el correo falle: un envio
/// es "lo tiro y espero", asi que si el SMTP esta caido o sin configurar en este
/// entorno, el reporte se perderia entero y la persona creeria que llego. Con la fila
/// en la base se puede reenviar o leerlo a mano.
model SupportRequest {
  id       String  @id @default(cuid())
  tenantId String
  userId   String?

  /// Que estaba haciendo y que paso, tal cual lo escribio la persona.
  activity String
  problem  String
  /// Si puede seguir trabajando. Sirve para priorizar sin leer todo el texto.
  blocking Boolean @default(false)

  /// Lo que se adjunto solo: pantalla, navegador, version, ultimos errores de API.
  /// Nunca contenido de conversaciones ni datos de contactos — eso es de los clientes
  /// del tenant y no hace falta para diagnosticar.
  context Json?

  /// Si el correo salio, y por que no si fallo. Null en emailError = no hubo problema.
  emailSent  Boolean @default(false)
  emailError String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String?
  conversationId String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([tenantId, createdAt])
  @@index([conversationId])
}

// ─── Campañas (envío masivo de plantillas) ────────────────────────────────────

enum CampaignStatus {
  DRAFT // cargada y revisada, todavia no se mando nada
  RUNNING // el worker esta procesando destinatarios
  PAUSED // frenada a mano, o por el limite diario de Meta
  DONE // no quedan pendientes
  CANCELLED // cancelada; los pendientes no se mandan nunca
}

enum CampaignRecipientStatus {
  PENDING // todavia no se intento
  SENDING // un worker la tomo (evita que dos procesos manden lo mismo)
  SENT // Meta la acepto
  FAILED // Meta la rechazo despues de los reintentos
  SKIPPED // no se mando a proposito (dado de baja, sin WhatsApp, repetido)
}

/// Un envio de una plantilla a muchos contactos. El progreso vive en CampaignRecipient,
/// no aca: estos contadores son un resumen para la pantalla, no la fuente de verdad.
model Campaign {
  id       String         @id @default(cuid())
  tenantId String
  name     String
  status   CampaignStatus @default(DRAFT)

  // Que se manda y por donde. La linea importa doble: el cliente recibe desde ese
  // numero, y la plantilla tiene que existir en el WABA de esa linea.
  templateId       String
  channelAccountId String

  createdById String

  // Destinatarios por minuto. Se guarda por campaña para poder ir mas despacio en un
  // numero nuevo, que arranca con un limite diario bajo de Meta.
  ratePerMinute Int @default(20)

  // Resumen para la pantalla; se recalcula desde CampaignRecipient.
  totalCount   Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)

  // Por que se freno sola (limite diario de Meta, token vencido…), para poder decirlo.
  pausedReason String?

  /// Con que se armo la lista: { source, tagIds, excludeTagIds, tagMatch, search }.
  /// Los destinatarios se congelan al crear la campaña, asi que esto no se usa para
  /// enviar — es para poder mirar despues a quienes se les escribio y por que, y para
  /// repetir la misma segmentacion sin volver a armarla a mano.
  recipientFilter Json?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template       MessageTemplate     @relation(fields: [templateId], references: [id])
  channelAccount ChannelAccount      @relation(fields: [channelAccountId], references: [id])
  createdBy      User                @relation(fields: [createdById], references: [id])
  recipients     CampaignRecipient[]

  @@index([tenantId, status])
}

/// Un destinatario de una campaña. Es la unidad de trabajo y la fuente de verdad del
/// progreso: si el proceso se reinicia a mitad de una campaña, al volver sigue por los
/// que quedaron PENDING y nadie recibe dos veces.
model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  tenantId   String
  contactId  String
  status     CampaignRecipientStatus @default(PENDING)

  /// Los valores de las {{n}} de ESTE destinatario: { body: [...], header: [...], buttons: [...] }.
  /// Salen de las columnas extra del Excel, asi que cambian fila por fila.
  variables Json?

  /// Se resuelve al armar la campaña y se congela: si el contacto cambia de numero
  /// despues, la campaña sigue apuntando a quien se reviso y aprobo.
  recipientPhone String

  messageId      String?
  conversationId String?
  error          String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  /// Cuando un worker tomo esta fila. Sirve para destrabar las que quedaron en SENDING
  /// porque el proceso se cayo justo despues de tomarlas.
  claimedAt      DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Lo que hace la campaña idempotente: el mismo contacto no puede entrar dos veces.
  @@unique([campaignId, contactId])
  /// El worker busca por aca: pendientes de una campaña, en orden de carga.
  @@index([campaignId, status])
}

// ─── Consumo de IA ────────────────────────────────────────────────────────────

/// Precio de un modelo de IA, en USD por millon de tokens.
///
/// La tabla es INMUTABLE a proposito: cambiar un precio es insertar una fila nueva con
/// otra fecha de vigencia, nunca editar la anterior. Es lo unico que permite responder
/// en marzo por que se cobro lo que se cobro en enero — cada uso guarda con que fila se
/// calculo, asi que el numero viejo se puede reproducir aunque el precio haya cambiado
/// tres veces desde entonces.
model AiPrice {
  id       String @id @default(cuid())
  provider String @default("openai")
  model    String

  inputPerMTok       Decimal @db.Decimal(12, 6)
  /// Los tokens de entrada que el proveedor sirve desde su cache salen mas baratos.
  /// Cuando un modelo no tiene descuento, se carga el mismo precio que la entrada normal.
  cachedInputPerMTok Decimal @db.Decimal(12, 6)
  outputPerMTok      Decimal @db.Decimal(12, 6)

  /// Desde cuando rige. Para cada uso se toma la fila vigente mas reciente a esa fecha.
  effectiveFrom DateTime @default(now())
  /// De donde salio el precio (lista publica, acuerdo, etc). Texto libre.
  source        String?
  createdAt     DateTime @default(now())

  usages AiUsage[]

  @@unique([provider, model, effectiveFrom])
  @@index([provider, model, effectiveFrom])
}

/// Una llamada a un proveedor de IA: que gasto y cuanto vale comercialmente.
///
/// Se escribe SIEMPRE, incluida la llamada que fallo (con error y los tokens en cero):
/// la tasa de error del proveedor es justamente lo que explica los "el bot no responde"
/// que hoy no dejan rastro.
///
/// Los tokens son la fuente de verdad, no el costo: costMicros es un derivado del
/// precio vigente y se puede recalcular entero si un precio estaba mal cargado.
model AiUsage {
  id       String @id @default(cuid())
  tenantId String

  /// Para que se uso: "bot_ai_chat" (el bot respondiendole a un cliente final) o
  /// "agent_suggestion" (sugerencia de respuesta para un agente humano).
  feature  String
  provider String @default("openai")
  model    String

  inputTokens       Int @default(0)
  cachedInputTokens Int @default(0)
  outputTokens      Int @default(0)

  /// Costo del proveedor en millonesimas de dolar (1.000.000 = US$1). Entero para que
  /// sumar un mes no arrastre error de coma flotante.
  costMicros   Int     @default(0)
  priceId      String?
  markupFactor Decimal @db.Decimal(6, 3)

  /// Lo que corresponde cobrar por esta operacion. En la fase de medicion se calcula
  /// pero no se descuenta de ningun saldo: billed queda en false y el numero sirve
  /// para ver cuanto se facturaria si el cobro estuviera activo.
  credits Int     @default(0)
  billed  Boolean @default(false)
  /// La reserva con la que se autorizo. Null = no hubo cobro (modo BYOK, o una llamada
  /// anterior al motor de creditos).
  holdId  String?

  /// Idempotencia: un reintento con el mismo requestId no puede registrarse dos veces.
  requestId         String  @unique
  /// El id que devuelve el proveedor, para poder conciliar contra su factura.
  providerRequestId String?

  conversationId String?
  userId         String?
  /// Que contesto el proveedor cuando fallo. Null = la llamada salio bien.
  error          String?

  createdAt DateTime @default(now())

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  price         AiPrice?        @relation(fields: [priceId], references: [id])
  hold          AiHold?         @relation(fields: [holdId], references: [id], onDelete: SetNull)
  creditEntries AiCreditEntry[]
  conversation  Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, feature, createdAt])
  @@index([createdAt])
}

// ─── Saldo de creditos de IA ──────────────────────────────────────────────────

enum AiBillingMode {
  /// Bring your own key: el tenant trae su clave y le factura el proveedor.
  BYOK
  /// Usa nuestra clave y consume creditos.
  PLATFORM
}

/// El saldo de una empresa, en una sola fila.
///
/// Existe por una razon precisa y no por comodidad: es el **punto unico de
/// serializacion**. Toda autorizacion es un UPDATE condicional sobre esta fila, asi que
/// dos conversaciones simultaneas del mismo tenant se ordenan solas y las de tenants
/// distintos no se estorban. Sumar los lotes en cada turno seria correcto pero no
/// serializable, que es justo lo que hace falta.
///
/// `spendable` esta materializado (= balance - reserved) porque Prisma no sabe comparar
/// dos columnas en un where: teniendolo aparte, la autorizacion entera es una sola
/// escritura atomica, sin SELECT FOR UPDATE ni transaccion larga.
model AiWallet {
  tenantId String @id

  /// Creditos que la empresa posee (suma de lo que queda en sus lotes vivos).
  balance   Int @default(0)
  /// Retenidos por operaciones en vuelo.
  reserved  Int @default(0)
  /// Lo autorizable ahora mismo. Invariante: spendable = balance - reserved.
  spendable Int @default(0)

  /// Corte manual, independiente del saldo: permite apagarle la IA a una empresa sin
  /// tocarle los creditos que ya pago.
  aiEnabled Boolean @default(true)

  /// Hasta que umbral de consumo ya se aviso (50, 75, 90, 100).
  ///
  /// Subir un escalon manda el aviso; bajar (una recarga, un ajuste) mueve el umbral
  /// hacia abajo EN SILENCIO, para que el aviso vuelva a estar disponible cuando el
  /// consumo suba otra vez sin mandar un "usaste la mitad" en el momento de recargar.
  /// Es lo que cumple "una sola vez por umbral y por ciclo" sin necesitar un motor de
  /// suscripciones, que hoy no existe.
  lastAlertThreshold Int       @default(0)
  lastAlertAt        DateTime?

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum AiLotKind {
  /// Incluidos en la mensualidad. Vencen al cerrar el periodo.
  MONTHLY_ALLOCATION
  /// Comprados aparte. No vencen, salvo que la politica comercial lo diga.
  PURCHASE
  /// Regalados: prueba, compensacion, promocion.
  BONUS
  /// Correccion manual hacia arriba.
  ADJUSTMENT
}

/// Un lote de creditos acreditado, con su propio vencimiento.
///
/// Reemplaza a las dos bolsas (mensuales / comprados) de la especificacion original.
/// Con lotes, "los incluidos vencen y los comprados no" deja de ser una rama del codigo
/// y pasa a ser un dato (expiresAt), y el orden de consumo es simplemente "primero el
/// que vence antes". Una promo o un bono futuro es un lote mas, sin codigo nuevo.
model AiCreditLot {
  id       String    @id @default(cuid())
  tenantId String
  kind     AiLotKind

  /// Lo acreditado, y lo que queda. remaining nunca baja de cero.
  credits   Int
  remaining Int

  /// Null = no vence.
  expiresAt DateTime?
  /// Cuando se vacio o vencio. Cerrado = no se vuelve a mirar.
  closedAt  DateTime?

  /// A que ciclo pertenece, para medir el consumo del periodo contra lo asignado.
  periodId        String?
  note            String?
  /// Quien lo cargo. Null = lo genero el sistema (asignacion mensual, vencimiento).
  createdByUserId String?

  createdAt DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries AiCreditEntry[]

  /// Por aca se elige de que lote descontar: los vivos, del que vence antes al que no
  /// vence nunca.
  @@index([tenantId, closedAt, expiresAt])
}

enum AiHoldStatus {
  HELD
  SETTLED
  RELEASED
  EXPIRED
}

/// Creditos retenidos mientras una operacion esta en vuelo.
///
/// Sin esto, dos turnos simultaneos con saldo para uno solo se autorizan los dos. Y sin
/// expiresAt, un contenedor reiniciado a mitad de llamada deja esos creditos retenidos
/// para siempre: el cliente reclama creditos que nunca uso y no hay como explicarselo.
/// Un barrido libera las vencidas.
model AiHold {
  id       String       @id @default(cuid())
  tenantId String
  status   AiHoldStatus @default(HELD)

  /// Lo reservado, calculado por el PEOR caso (entrada estimada + maximo de salida).
  /// Que sea el techo y no un promedio es lo que hace que el consumo real nunca lo
  /// supere, y por eso el saldo no se va a negativo por el camino normal.
  credits Int

  feature        String
  model          String
  conversationId String?
  userId         String?

  expiresAt DateTime
  settledAt DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usages AiUsage[]

  /// El barrido busca por aca: reservas vivas que ya vencieron.
  @@index([status, expiresAt])
  @@index([tenantId, createdAt])
}

enum AiCreditEntryKind {
  MONTHLY_ALLOCATION
  PURCHASE
  BONUS
  AI_USAGE
  EXPIRATION
  REFUND
  ADJUSTMENT
}

/// El libro mayor. Nunca se edita ni se borra una fila: una correccion es un movimiento
/// compensatorio.
///
/// Es la autoridad comercial frente al cliente — no el proveedor, que factura con otro
/// criterio y con otra fecha. balanceBefore/balanceAfter se guardan aunque sean
/// derivables: permiten auditar la secuencia sin recalcular todo el historico.
model AiCreditEntry {
  id       String            @id @default(cuid())
  tenantId String
  kind     AiCreditEntryKind

  /// Positivo suma, negativo resta.
  credits       Int
  balanceBefore Int
  balanceAfter  Int

  /// De que lote salieron o a que lote entraron. Un consumo que toca dos lotes escribe
  /// dos filas, una por lote.
  lotId   String?
  /// El uso que lo genero, cuando es un consumo.
  usageId String?

  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot    AiCreditLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  usage  AiUsage?     @relation(fields: [usageId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ─── Agenda de citas ──────────────────────────────────────────────────────────
// Citas por clinica, con doctores que rotan entre clinicas. Nacio para Red Dental.
//
// La clinica es la LINEA de WhatsApp (ChannelAccount), no un modelo aparte: cada
// clinica ya tiene su linea, y asi la recepcion ve solo su agenda con el mismo permiso
// por linea (UserChannelAccount) que ya limita su bandeja. El costo: si una clinica se
// reconecta como linea nueva, sus citas quedan en la vieja y hay que moverlas.
//
// Los horarios de turnos y excepciones son MINUTOS DESDE MEDIANOCHE en hora local de
// la empresa (Tenant.timezone), porque "los lunes de 8:00 a 13:00" no es un instante:
// es una hora de reloj que se repite. Las citas si son instantes (UTC, como todo el
// resto de la base).

/// Configuracion de la agenda de una empresa. Sin fila = la empresa no usa agenda.
model AgendaSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  enabled                 Boolean  @default(true)
  /// Duracion por defecto de una cita. Red Dental: 45. Se puede alargar de a 15.
  slotMinutes             Int      @default(45)
  reminderHoursBefore     Int      @default(24)
  /// Hora local a la que sale el resumen del dia a cada doctor.
  doctorSummaryHour       Int      @default(7)
  /// Plantilla de cada aviso. Null = ese aviso no se manda. Se eligen en pantalla y no
  /// por nombre fijo porque cada empresa crea y nombra las suyas, y Meta tiene que
  /// aprobarlas antes: la agenda tiene que funcionar mientras tanto.
  confirmationTemplateId  String?
  reminderTemplateId      String?
  doctorSummaryTemplateId String?
  delayTemplateId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Quien atiende. NO es un User: el doctor no entra al sistema, ve sus citas por el
/// enlace que le llega por WhatsApp. Si algun dia necesita acceso se le asocia un
/// usuario sin rehacer nada de esto.
model Doctor {
  id        String   @id @default(cuid())
  tenantId  String
  /// Como lo nombra la clinica: "Dr.02", "Dra.03". Es lo que se ve en la grilla.
  code      String
  name      String
  /// WhatsApp del doctor, solo digitos con codigo de pais (igual que ContactIdentity).
  /// Null = no recibe el resumen del dia.
  phone     String?
  /// Un doctor que se va se desactiva, no se borra: sus citas pasadas lo nombran.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shifts       DoctorShift[]
  exceptions   DoctorException[]
  appointments Appointment[]
  summaries    DoctorDailySummary[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Turno que se repite todas las semanas: "los lunes de 8:00 a 13:00 en Villa Clarita".
/// Un doctor puede tener varios el mismo dia (mañana en una clinica, tarde en otra);
/// que no se pisen entre si lo valida el servicio.
model DoctorShift {
  id               String   @id @default(cuid())
  tenantId         String
  doctorId         String
  channelAccountId String
  /// 0 = domingo ... 6 = sabado, como Date.getDay().
  weekday          Int
  startMinute      Int
  endMinute        Int
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@index([doctorId, weekday])
  @@index([channelAccountId, weekday])
}

/// Lo que cambia UN dia respecto del turno semanal.
///
/// ABSENT resta: vacaciones o ausencia, del dia entero (sin horario) o de unas horas.
/// WORKS_AT reemplaza: si un dia tiene al menos un WORKS_AT, los turnos semanales de ese
/// dia no cuentan y valen solo los WORKS_AT ("este jueves va a Zona 5"). Asi un cambio
/// puntual se carga como una fila, sin tocar el turno semanal.
model DoctorException {
  id               String              @id @default(cuid())
  tenantId         String
  doctorId         String
  date             DateTime            @db.Date
  kind             DoctorExceptionKind
  /// Null en los dos = el dia entero (solo tiene sentido en ABSENT).
  startMinute      Int?
  endMinute        Int?
  /// Solo WORKS_AT: la clinica de ese dia.
  channelAccountId String?
  note             String?
  createdAt        DateTime            @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor         Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@index([doctorId, date])
  @@index([tenantId, date])
}

enum DoctorExceptionKind {
  ABSENT
  WORKS_AT
}

/// Una cita. El paciente elige clinica y hora; el doctor lo asigna el sistema.
///
/// Dos citas activas del mismo doctor NO pueden pisarse: lo garantiza una restriccion
/// de exclusion en Postgres (ver la migracion 20261002000000_agenda), no solo el
/// servicio. Si dos recepciones agendan al mismo doctor en el mismo segundo, la base
/// rechaza la segunda. Prisma no sabe expresar esa restriccion, por eso no aparece aca.
model Appointment {
  id               String            @id @default(cuid())
  tenantId         String
  /// La clinica.
  channelAccountId String
  doctorId         String
  contactId        String
  startsAt         DateTime
  endsAt           DateTime
  reason           String?
  notes            String?
  status           AppointmentStatus @default(SCHEDULED)
  createdById      String?

  /// Mensajes de aviso (Message.id). El del recordatorio es el que permite reconocer a
  /// que cita responde el paciente cuando toca "Confirmo" o "Reprogramar": Meta manda
  /// en la respuesta el id del mensaje original (context.id = Message.externalId).
  confirmationMessageId String?
  reminderMessageId     String?
  /// Se marca al TOMAR la cita para mandarle la confirmacion, igual que reminderSentAt:
  /// es lo que impide mandarla dos veces. Al mover la cita vuelve a null y sale una
  /// confirmacion nueva con el horario nuevo.
  confirmationSentAt    DateTime?
  /// Por que no se le pudo avisar al paciente la ultima vez (plantilla sin aprobar,
  /// linea caida, numero invalido). Se muestra en la cita: si no, un aviso que no salio
  /// no deja rastro y la clinica cree que el paciente sabe.
  notifyError           String?
  /// Se marca ANTES de mandar, al tomar la cita: es lo que impide mandar dos veces el
  /// recordatorio si hay dos procesos o el worker se reinicia.
  reminderSentAt        DateTime?
  confirmedAt           DateTime?
  rescheduleRequestedAt DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: borrar una linea o un contacto con citas tiene que fallar, no llevarse
  // la agenda de una clinica por delante.
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)
  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy      User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, channelAccountId, startsAt])
  @@index([doctorId, startsAt])
  @@index([contactId])
  @@index([status, startsAt])
  @@index([reminderMessageId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  DONE
  NO_SHOW
  CANCELLED
}

/// Registro del resumen de la mañana que se le manda a cada doctor. El unique por
/// (doctor, dia) es lo que impide mandarlo dos veces si el proceso se reinicia.
model DoctorDailySummary {
  id        String   @id @default(cuid())
  tenantId  String
  doctorId  String
  date      DateTime @db.Date
  messageId String?
  error     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
}
