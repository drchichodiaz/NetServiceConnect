# Usado por docker-compose.prod.yml. Copiar a ".env.production" (para el contenedor
# del backend) y a ".env" (docker compose lo lee solo automáticamente para sus propias
# sustituciones ${VAR} — puede ser el mismo archivo, con los dos nombres).

# ─── Postgres (contenedor propio, no compartido con otras apps del servidor) ───
DB_USER=netservice
DB_PASSWORD=cambia-esto-por-algo-fuerte
DB_NAME=netservice_connect

# ─── Backend (netservice_backend) ───
JWT_SECRET=genera-algo-largo-y-random
JWT_EXPIRES_IN=7d
# App ID / App Secret / Verify Token de Meta: dejar vacío acá y cargarlos desde
# Configuración > Sistema una vez la app esté corriendo (quedan en DB, tienen
# prioridad sobre esto — ver SystemConfigService.get()). Estos son solo fallback.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v19.0
# Igual que arriba: se puede dejar vacío y cargar la clave por tenant desde
# Configuración > IA una vez logueado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3001
FRONTEND_URL=https://connect.adsystemsoftware.com

# ─── Frontend (build args — se hornean en el bundle, no son runtime env) ───
NEXT_PUBLIC_API_URL=https://connect.adsystemsoftware.com/api
BRAND_NAME=Tu Producto
BRAND_TAGLINE=Tu propia bajada de producto
ENABLE_NETSERVICE_PANEL=false
